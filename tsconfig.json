{
  "compilerOptions": {
    "jsx": "react-jsx",
    "jsxImportSource": "@opentui/solid",
    "module": "esnext",
    "moduleResolution": "bundler",
    "target": "esnext",
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "skipLibCheck": true,
    "noEmit": true,
    "allowImportingTsExtensions": true,
    "paths": {
      "@opencode/plugin": ["./test/stubs/@opencode-plugin.ts"],
      "@opencode/plugin/rpc": ["./test/stubs/@opencode-plugin-rpc.ts"]
    }
  }
}
